# Drop-in for office-exporter.service: hide the secrets of every *named* Hermes profile.
#
# The base unit already hides the default profile's .env/auth.json and everything outside
# the bound Hermes data dir. Named profiles live in <hermes_home>/profiles/<name>/ and
# carry their own credentials, so list them here (one line per profile):
#
#   sudo install -d /etc/systemd/system/office-exporter.service.d
#   sudo cp hide-profile-secrets.conf.example \
#        /etc/systemd/system/office-exporter.service.d/hide-profile-secrets.conf
#   # replace "scout" with your profile names, then:
#   sudo systemctl daemon-reload && sudo systemctl restart office-exporter
#
# Verify: `systemctl show office-exporter -p InaccessiblePaths` lists every profile.

[Service]
InaccessiblePaths=-/opt/hermes-platform/data/profiles/scout/.env
InaccessiblePaths=-/opt/hermes-platform/data/profiles/scout/auth.json
