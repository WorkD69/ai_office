# Cloudflare static-asset headers.
#
# script-src: only our bundle and the exact Telegram Mini App SDK file (a CSP source with a path
#   that does not end in "/" matches that path exactly).
# style-src 'unsafe-inline': needed by the Telegram SDK, which injects <style> elements (theme
#   styles sent by Telegram Web, bottom-button animation). Our own code uses only the bundled
#   stylesheet and CSSOM style properties, which CSP does not restrict.
# frame-ancestors: Telegram Web (web.telegram.org/k, /a) embeds Mini Apps in an iframe;
#   native Telegram clients use a WebView and are not affected by this directive.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://telegram.org/js/telegram-web-app.js; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pixel Agents art: the path carries the upstream tag; a new art version gets a new path.
/pixel-agents/v1.6.0/*
  Cache-Control: public, max-age=31536000, immutable
